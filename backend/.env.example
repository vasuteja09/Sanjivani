# Sanjivani AI (CodeShield AI) - Backend Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./sanjivani.db
MAX_UPLOAD_SIZE_MB=1
SCAN_TIMEOUT_SECONDS=30

# Optional AI Configuration (Compatible with OpenAI / OpenRouter / Groq / Ollama / LocalAI)
# If empty, the scanner works with built-in rule-based remediation guides.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
